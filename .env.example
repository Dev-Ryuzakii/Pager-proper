# FastAPI Environment Configuration
# Copy this to .env for local development

# Server Configuration
DEBUG=True
HOST=0.0.0.0
PORT=8001

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Files
USER_KEYS_FILE=user_keys_secure.json
OFFLINE_MESSAGES_FILE=offline_messages.json

# TLS Server Integration
TLS_SERVER_HOST=127.0.0.1
TLS_SERVER_PORT=5050

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=fastapi_mobile_backend.log

# Production Mode (set to True in production)
PRODUCTION=False

# Local Ollama on the API VPS. Decoy generation uses only organization metadata
# and earlier decoy text; encrypted message contents are never sent to the model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
DECOY_LLM=1
# Optional overrides. Leave DECOY_LLM_URL empty to use OLLAMA_BASE_URL.
DECOY_LLM_URL=
DECOY_LLM_MODEL=qwen2.5:7b
DECOY_LLM_CONTEXT_TIMEOUT=6
DECOY_LLM_TIMEOUT=20
DECOY_LLM_THREADS=6
DECOY_LLM_POOL=16

# Organization invitations
DILARION_APP_URL=dilarion://activate
# Hosting layout (Afribase):
#   https://dilarion.xyz           -> dilarion-app/web      (site + organization portal)
#   https://admin.dilarion.xyz     -> pager-admin           (admin console)
#   https://web.dilarion.xyz       -> dilarion-app/desktop  (Dilarion web app, `npm run build:test`)
# These are only used for links inside emails.
DILARION_WEB_URL=https://dilarion.xyz
DILARION_ORG_PORTAL_URL=https://dilarion.xyz/#/login
DILARION_ADMIN_URL=https://admin.dilarion.xyz/admin/organizations
# Optional. Leave empty to embed the logo inside each email (recommended:
# shows even when the mail client blocks remote images). Or point it at
# <public API>/brand/dilarion-logo.png.
DILARION_LOGO_URL=
ADMIN_NOTIFICATION_EMAIL=

# Resend SMTP (SMTP_FROM must use a domain verified in Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Dilarion <notifications@your-verified-domain.com>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_STARTTLS=0
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM=Dilarion <notifications@your-verified-domain.com>
# Where replies go (a monitored inbox improves trust/deliverability).
SMTP_REPLY_TO=support@your-verified-domain.com

# SMS — Sendchamp (preferred). Get the access key from Sendchamp dashboard
# > Settings > API Keys. SENDER_NAME must be a sender ID approved on your
# account. Route: dnd (reaches DND numbers; recommended for codes), non_dnd,
# or international. Local numbers (080...) get the default country code.
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_NAME=SAlert
SENDCHAMP_ROUTE=dnd
SENDCHAMP_DEFAULT_COUNTRY_CODE=234
SENDCHAMP_BASE_URL=https://api.sendchamp.com/api/v1

# Approximate location (city, country) of blocked sign-in attempts, from IP.
# Set GEOIP_DISABLED=1 to stop sending sign-in IPs to the lookup service.
GEOIP_URL=http://ip-api.com/json/{ip}?fields=status,city,regionName,country
GEOIP_DISABLED=0

# Twilio — only used if SENDCHAMP_API_KEY is empty.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google Calendar two-way sync (link an account from the app, pull its events
# into the Dilarion calendar, and push Dilarion meetings/tasks into it).
# Setup: console.cloud.google.com > enable the Google Calendar API > OAuth
# consent screen with the scope .../auth/calendar.events (publish it — while
# the consent screen stays in Testing, Google expires refresh tokens after 7
# days) > Credentials > OAuth client ID (Web application) with an authorized
# redirect URI matching GOOGLE_REDIRECT_URI exactly. Leave blank to disable;
# the /calendar/google/* routes return 503 until all three are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-host/calendar/google/callback
